NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Pooled (PgBouncer transaction mode) — used by the running app.
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Direct/session-mode — used only by `prisma migrate`/`db push`. On Supabase
# this is the same host/credentials as DATABASE_URL, just port 5432 instead
# of 6543; transaction-mode pooling doesn't support what Migrate needs.
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Supabase Storage — file uploads (admin audio/images, candidate speaking
# recordings). Same Supabase project as the database above. SUPABASE_URL is
# the project's API URL (https://<project-ref>.supabase.co), NOT the
# Postgres connection string. SUPABASE_SERVICE_ROLE_KEY is the service_role
# key from Project Settings > API — server-only, never expose to the client.
# Create the bucket (Storage > New bucket) before first use; make it public
# if you want getPublicUrl() to resolve, matching the old local /public/uploads
# behavior (world-readable via the returned URL, not listable/enumerable).
SUPABASE_URL="https://xxxxxxxxxxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
SUPABASE_STORAGE_BUCKET="uploads"

# Upstash Redis — rate limiting (lib/rateLimit/*). Create a Redis database at
# https://console.upstash.com and copy its REST URL/token (NOT a redis:// URL —
# the REST API is what makes this work on Vercel serverless/Edge). If these
# are unset, rate limiting fails OPEN (requests are allowed through, not
# blocked) rather than taking the API down — see lib/rateLimit/enforce.ts.
UPSTASH_REDIS_REST_URL="https://xxxxxxxxxxxxxxxxxxxx.upstash.io"
UPSTASH_REDIS_REST_TOKEN="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email (lib/email/*) — Resend by default, kept swappable (see lib/email/sendEmail.ts).
# If RESEND_API_KEY is unset, email sending automatically falls back to
# logging instead of a real send, so local dev works without an API key.
EMAIL_PROVIDER="resend"
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM_ADDRESS="IELTS Clone <notifications@example.com>"

# Observability (lib/logger.ts, sentry.*.config.ts) — all optional. Without
# SENTRY_DSN, Sentry.init() safely no-ops (nothing is sent, no error). The
# SENTRY_ORG/PROJECT/AUTH_TOKEN trio is only needed for source-map upload at
# build time (see DEPLOYMENT.md) — without them, withSentryConfig just skips
# that step with a warning, the app itself is unaffected.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
LOG_LEVEL="info"

# SEO (app/robots.ts, app/sitemap.ts, app/layout.tsx metadata) — the real
# production domain, no trailing slash. Falls back to localhost for dev;
# canonical URLs/sitemap entries/OG image URLs are all wrong without this
# set correctly in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
